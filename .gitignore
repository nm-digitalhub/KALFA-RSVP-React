# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# isolated verification/staging builds + ad-hoc NEXT_DIST_DIR=.next-<label>
/.next-*/
/.next.old/
# manual pre-deploy backup (rename of .next; not used by the deploy script)
/.next.rollback/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented example template should be committed
!.env.example

# vercel
.vercel

# claude code session data — EXCEPT project agents + skills, which are team
# assets shared via git (official project-subagent convention)
.remember/
.claude/*
!.claude/agents/
!.claude/skills/
# project harness settings (SessionStart fleet inbox hook) — team asset
!.claude/settings.json
# autonomous fleet — config, roles, scheduler, guards are team assets; the
# headless OAuth token and the redacted customer-reply corpus NEVER commit
!.claude/fleet/
.claude/fleet/.token.env*
.claude/fleet/roles/support-drafter.examples.md

# installed agent skills (tooling — reinstallable via `npx skills`; tracked via skills-lock.json)
.agents/skills/

# skills-CLI symlink farm for other agent runtimes (machine-local, regenerable)
.hermes/

# typescript
*.tsbuildinfo
next-env.d.ts
dist/
# Server-side secret files (GA4 service-account key etc. — private keys inside)
.secrets/

# Voximplant service-account keys + voxengine-ci config (NEVER commit — RSA private key inside)
voxi_auth.json
vox_ci_credentials.json
*vox*credentials*.json
voximplant-ci/voximplant.json
storage_state.json

# per-deploy version-skew id (written by npm run deploy)
/.deploy-id
*.swp

# local scratch (downloaded reports etc.)
/tmp/

# personal tax certificate (PII: ID number + home address) — NEVER commit
/taxes.pdf
.claude/skills/elevenlabs-docs.zip

# fleet: runtime logs + headless auth token (never committed)
.fleet-logs/
.claude/fleet/.token.env
.claude/fleet/KILLSWITCH

# filebrowser live tool database (may contain credential hashes) — never commit
/filebrowser.db
__pycache__/

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
# Ruflo runtime state (zeroed telemetry, regenerated on init) + machine-local
# resolution paths — not source, and .swarm/ruvector.db sit at repo root
# outside .claude-flow/ so the rules above don't reach them.
.claude-flow/metrics/
.claude-flow/security/
.claude-flow/memory-package.json
.swarm/
/ruvector.db

# device telemetry: diagnostic log written by POST /api/agents/telemetry (never committed)
.telemetry/

# Voximplant session logs pulled by `npm run voximplant -- log --session <id>`.
# They land at the repo root and they carry guest PII — the called number in
# full, and on an RSVP call the guest's spoken answers in the scenario's own
# log lines. Downloading one is a normal diagnostic step; committing one
# publishes a third party's phone number and what they said on the phone.
/session-*.log

# Debug downloads of DEPLOYED VoxEngine scenarios (npm run voximplant -- scenario --id N).
# Snapshots of what the platform is running, not source — the source of truth is
# voxfiles/scenarios/src/. Committing them would create a second, silently stale copy.
scenario-*.deployed.js
