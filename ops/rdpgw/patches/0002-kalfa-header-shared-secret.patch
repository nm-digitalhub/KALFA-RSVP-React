+func TestHeaderAuthSharedSecret(t *testing.T) {
+	InitStore([]byte("0123456789abcdef0123456789abcdef"), []byte("0123456789abcdef0123456789abcdef"), "cookie", 0)
+	h := (&HeaderConfig{
+		UserHeader:     "X-User",
+		TrustedProxies: []string{"127.0.0.1/32"},
+		SecretHeader:   "X-Internal",
+		Secret:         "0123456789abcdef0123456789abcdef",
+	}).New()
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) })
+	call := func(secret string) int {
+		r := httptest.NewRequest("GET", "/connect", nil)
+		r.RemoteAddr = "127.0.0.1:1234"
+		r.Header.Set("X-User", "staff-1")
+		if secret != "" {
+			r.Header.Set("X-Internal", secret)
+		}
+		w := httptest.NewRecorder()
+		EnrichContext(h.Authenticated(next)).ServeHTTP(w, r)
+		return w.Code
+	}
+	if c := call(""); c != http.StatusUnauthorized {
+		t.Errorf("missing secret: %d", c)
+	}
+	if c := call("nope"); c != http.StatusUnauthorized {
+		t.Errorf("wrong secret: %d", c)
+	}
+	if c := call("0123456789abcdef0123456789abcdef"); c != http.StatusNoContent {
+		t.Errorf("right secret: %d", c)
+	}
+}
