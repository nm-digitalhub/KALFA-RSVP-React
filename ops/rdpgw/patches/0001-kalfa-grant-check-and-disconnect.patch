--- /dev/null
+++ b/cmd/rdpgw/security/grant.go
@@ -0,0 +1,102 @@
+package security
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"time"
+)
+
+// GrantRequest is what rdpgw sends to the grant authority (KALFA) for every
+// new tunnel. It carries no token and no credentials.
+type GrantRequest struct {
+	User         string `json:"user"`
+	ClientIp     string `json:"clientIp"`
+	Target       string `json:"target"`
+	TunnelId     string `json:"tunnelId"`
+	RdgConnectId string `json:"rdgConnectionId"`
+}
+
+// GrantResult is the authority's answer. Only an explicit allow=true is an
+// allow; ExpiresAt, when set, is a hard deadline after which rdpgw closes the
+// tunnel by itself even if the revocation call never arrives.
+type GrantResult struct {
+	Allow     bool      `json:"allow"`
+	GrantId   string    `json:"grantId"`
+	ExpiresAt time.Time `json:"expiresAt"`
+}
+
+// GrantCheckFunc decides whether a user may open a new tunnel right now.
+type GrantCheckFunc func(ctx context.Context, req GrantRequest) (GrantResult, error)
+
+// GrantCheck is consulted by CheckPAACookie for every new tunnel. It is set at
+// start-up; when nil CheckPAACookie keeps its original behaviour.
+var GrantCheck GrantCheckFunc
+
+// NewHTTPGrantCheck builds a GrantCheckFunc that POSTs to url with a bearer
+// token. It is fail-closed: any transport error, non-200 status, oversized or
+// malformed body, or allow!=true is a denial.
+func NewHTTPGrantCheck(url, bearer string, timeout time.Duration) GrantCheckFunc {
+	client := &http.Client{
+		Timeout: timeout,
+		Transport: &http.Transport{
+			Proxy:             nil, // never route the check through an env proxy
+			DisableKeepAlives: false,
+			MaxIdleConns:      4,
+			IdleConnTimeout:   30 * time.Second,
+		},
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+	return func(ctx context.Context, gr GrantRequest) (GrantResult, error) {
+		body, err := json.Marshal(gr)
+		if err != nil {
+			return GrantResult{}, err
+		}
+		ctx, cancel := context.WithTimeout(ctx, timeout)
+		defer cancel()
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
+		if err != nil {
+			return GrantResult{}, err
+		}
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Authorization", "Bearer "+bearer)
+		resp, err := client.Do(req)
+		if err != nil {
+			return GrantResult{}, fmt.Errorf("grant check unreachable: %w", err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			io.Copy(io.Discard, io.LimitReader(resp.Body, 4096))
+			return GrantResult{}, fmt.Errorf("grant check status %d", resp.StatusCode)
+		}
+		var res GrantResult
+		dec := json.NewDecoder(io.LimitReader(resp.Body, 4096))
+		if err := dec.Decode(&res); err != nil {
+			return GrantResult{}, errors.New("grant check: malformed response")
+		}
+		return res, nil
+	}
+}
+
+// requireGrant runs the grant check for a tunnel. It returns nil only for an
+// explicit allow; the caller must treat every other outcome as access denied.
+func requireGrant(ctx context.Context, req GrantRequest) (GrantResult, error) {
+	if GrantCheck == nil {
+		return GrantResult{Allow: true}, nil
+	}
+	res, err := GrantCheck(ctx, req)
+	if err != nil {
+		log.Printf("grant check failed for user %q (denying): %s", req.User, err)
+		return GrantResult{}, err
+	}
+	if !res.Allow {
+		log.Printf("grant check denied user %q", req.User)
+		return GrantResult{}, errors.New("grant denied")
+	}
+	return res, nil
+}
