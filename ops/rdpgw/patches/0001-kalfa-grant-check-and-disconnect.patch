new file mode 100644
index 0000000..39a042e
--- /dev/null
+++ b/cmd/rdpgw/admin/admin.go
@@ -0,0 +1,94 @@
+// Package admin is a loopback-only control surface for the gateway: it lists
+// live tunnels and closes them (by tunnel id or by user). It is served on its
+// own listener, never on the public gateway port.
+package admin
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"fmt"
+	"log"
+	"net"
+	"net/http"
+	"strings"
+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/protocol"
+)
+
+type disconnectRequest struct {
+	User     string `json:"user"`
+	TunnelId string `json:"tunnelId"`
+}
+
+// RequireLoopback returns an error unless addr (host:port) is a loopback IP.
+func RequireLoopback(addr string) error {
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil {
+		return fmt.Errorf("invalid address %q: %w", addr, err)
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return fmt.Errorf("address %q is not a loopback IP", addr)
+	}
+	return nil
+}
+
+func authorized(r *http.Request, token string) bool {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		return false
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return false
+	}
+	got := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+	return len(token) >= 32 && subtle.ConstantTimeCompare([]byte(got), []byte(token)) == 1
+}
+
+// Handler returns the admin mux. token must be at least 32 bytes.
+func Handler(token string) http.Handler {
+	mux := http.NewServeMux()
+
+	mux.HandleFunc("/admin/v1/tunnels", func(w http.ResponseWriter, r *http.Request) {
+		if !authorized(r, token) {
+			http.Error(w, "forbidden", http.StatusForbidden)
+			return
+		}
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"tunnels": protocol.ListTunnels()})
+	})
+
+	mux.HandleFunc("/admin/v1/disconnect", func(w http.ResponseWriter, r *http.Request) {
+		if !authorized(r, token) {
+			http.Error(w, "forbidden", http.StatusForbidden)
+			return
+		}
+		if r.Method != http.MethodPost {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		var req disconnectRequest
+		dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+		dec.DisallowUnknownFields()
+		if err := dec.Decode(&req); err != nil || (req.User == "") == (req.TunnelId == "") {
+			http.Error(w, "exactly one of user or tunnelId is required", http.StatusBadRequest)
+			return
+		}
+		closed := 0
+		if req.User != "" {
+			closed = protocol.DisconnectUser(req.User)
+		} else if err := protocol.Disconnect(req.TunnelId); err == nil {
+			closed = 1
+		}
+		log.Printf("admin disconnect: user=%q tunnelId=%q closed=%d", req.User, req.TunnelId, closed)
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]int{"closed": closed})
+	})
+
+	return mux
+}
