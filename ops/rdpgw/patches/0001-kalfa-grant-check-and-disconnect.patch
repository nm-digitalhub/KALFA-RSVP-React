@@ -0,0 +1,61 @@
+package admin
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+const tok = "0123456789abcdef0123456789abcdef"
+
+func do(t *testing.T, h http.Handler, method, path, body, auth, remote string) *httptest.ResponseRecorder {
+	t.Helper()
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	r.RemoteAddr = remote
+	if auth != "" {
+		r.Header.Set("Authorization", auth)
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func TestAdminAuth(t *testing.T) {
+	h := Handler(tok)
+	if w := do(t, h, "GET", "/admin/v1/tunnels", "", "", "127.0.0.1:5000"); w.Code != 403 {
+		t.Errorf("no token: %d", w.Code)
+	}
+	if w := do(t, h, "GET", "/admin/v1/tunnels", "", "Bearer wrong", "127.0.0.1:5000"); w.Code != 403 {
+		t.Errorf("wrong token: %d", w.Code)
+	}
+	if w := do(t, h, "GET", "/admin/v1/tunnels", "", "Bearer "+tok, "10.1.2.3:5000"); w.Code != 403 {
+		t.Errorf("non-loopback with right token: %d", w.Code)
+	}
+	if w := do(t, h, "GET", "/admin/v1/tunnels", "", "Bearer "+tok, "127.0.0.1:5000"); w.Code != 200 {
+		t.Errorf("good request: %d", w.Code)
+	}
+	if w := do(t, Handler("short"), "GET", "/admin/v1/tunnels", "", "Bearer short", "127.0.0.1:5000"); w.Code != 403 {
+		t.Errorf("short server token must never authorize: %d", w.Code)
+	}
+}
+
+func TestAdminDisconnectValidation(t *testing.T) {
+	h := Handler(tok)
+	for _, body := range []string{``, `{}`, `{"user":"a","tunnelId":"b"}`, `{"user":"a","x":1}`, `nope`} {
+		if w := do(t, h, "POST", "/admin/v1/disconnect", body, "Bearer "+tok, "127.0.0.1:1"); w.Code != 400 {
+			t.Errorf("body %q: %d", body, w.Code)
+		}
+	}
+	if w := do(t, h, "POST", "/admin/v1/disconnect", `{"user":"nobody"}`, "Bearer "+tok, "127.0.0.1:1"); w.Code != 200 || !strings.Contains(w.Body.String(), `"closed":0`) {
+		t.Errorf("unknown user: %d %s", w.Code, w.Body.String())
+	}
+}
+
+func TestRequireLoopback(t *testing.T) {
+	for addr, ok := range map[string]bool{"127.0.0.1:3014": true, "[::1]:3014": true, "0.0.0.0:3014": false, "10.0.0.1:3014": false, "localhost:3014": false, "3014": false} {
+		if err := RequireLoopback(addr); (err == nil) != ok {
+			t.Errorf("%s: err=%v want ok=%v", addr, err, ok)
+		}
+	}
+}
