 }
+
+// DisconnectUser closes every live tunnel opened for the given user and
+// returns how many were closed.
+func DisconnectUser(user string) int {
+	if user == "" {
+		return 0
+	}
+	connectionsMu.RLock()
+	var victims []*Tunnel
+	for _, m := range Connections {
+		if m.Tunnel.Subject() == user {
+			victims = append(victims, m.Tunnel)
+		}
+	}
+	connectionsMu.RUnlock()
+
+	for _, t := range victims {
+		t.Close()
+	}
+	return len(victims)
+}
+
+// ListTunnels returns a snapshot of the live tunnels.
+func ListTunnels() []TunnelInfo {
+	connectionsMu.RLock()
+	defer connectionsMu.RUnlock()
+	out := make([]TunnelInfo, 0, len(Connections))
+	for _, m := range Connections {
+		out = append(out, m.Tunnel.Info())
+	}
+	return out
+}
