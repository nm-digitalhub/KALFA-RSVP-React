+package security
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/identity"
+	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/protocol"
+)
+
+const testBearer = "0123456789abcdef0123456789abcdef"
+
+func tunnelCtx(t *testing.T, user string) (context.Context, *protocol.Tunnel, string) {
+	t.Helper()
+	SigningKey = []byte("5aa3a1568fe8421cd7e127d5ace28d2d")
+	id := identity.NewUser()
+	id.SetUserName(user)
+	id.SetAttribute(identity.AttrClientIp, "203.0.113.7")
+	ctx := context.WithValue(context.Background(), identity.CTXKey, id)
+	tok, err := GeneratePAAToken(ctx, user, "host.example:3389")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tun := &protocol.Tunnel{Id: "t1", RDGId: "rdg1", User: identity.NewUser()}
+	return context.WithValue(ctx, protocol.CtxTunnel, tun), tun, tok
+}
+
+func withGrant(t *testing.T, h http.HandlerFunc, timeout time.Duration) {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	t.Cleanup(srv.Close)
+	prev := GrantCheck
+	GrantCheck = NewHTTPGrantCheck(srv.URL, testBearer, timeout)
+	t.Cleanup(func() { GrantCheck = prev })
+}
+
+func TestCheckPAACookieGrantAllow(t *testing.T) {
+	var got GrantRequest
+	var raw []byte
+	var token string
+	withGrant(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer "+testBearer {
+			http.Error(w, "no", http.StatusForbidden)
+			return
+		}
+		raw, _ = io.ReadAll(r.Body)
+		json.Unmarshal(raw, &got)
+		json.NewEncoder(w).Encode(GrantResult{Allow: true, ExpiresAt: time.Now().Add(time.Hour)})
+	}, time.Second)
+	ctx, tun, tok := tunnelCtx(t, "staff-1")
+	token = tok
+	ok, err := CheckPAACookie(ctx, tok)
+	if !ok || err != nil {
+		t.Fatalf("want allow, got ok=%v err=%v", ok, err)
+	}
+	if got.User != "staff-1" || got.ClientIp != "203.0.113.7" || got.Target != "host.example:3389" || got.TunnelId != "t1" {
+		t.Errorf("grant request carried wrong data: %+v", got)
+	}
+	if len(raw) == 0 || bytes.Contains(raw, []byte(token)) {
+		t.Error("the PAA token must never be sent to the grant authority")
+	}
+	tun.Close()
+}
+
+func TestCheckPAACookieGrantFailsClosed(t *testing.T) {
+	cases := map[string]http.HandlerFunc{
+		"deny":      func(w http.ResponseWriter, r *http.Request) { json.NewEncoder(w).Encode(GrantResult{Allow: false}) },
+		"http 500":  func(w http.ResponseWriter, r *http.Request) { http.Error(w, "boom", 500) },
+		"http 403":  func(w http.ResponseWriter, r *http.Request) { http.Error(w, "no", 403) },
+		"bad json":  func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("{")) },
+		"empty 200": func(w http.ResponseWriter, r *http.Request) {},
+		"slow": func(w http.ResponseWriter, r *http.Request) {
+			time.Sleep(500 * time.Millisecond)
+			json.NewEncoder(w).Encode(GrantResult{Allow: true})
+		},
+	}
+	for name, h := range cases {
+		t.Run(name, func(t *testing.T) {
+			withGrant(t, h, 100*time.Millisecond)
+			ctx, _, tok := tunnelCtx(t, "staff-1")
+			if ok, _ := CheckPAACookie(ctx, tok); ok {
+				t.Fatal("must deny")
+			}
+		})
+	}
+}
+
+func TestCheckPAACookieUnreachableAuthorityDenies(t *testing.T) {
+	prev := GrantCheck
+	GrantCheck = NewHTTPGrantCheck("http://127.0.0.1:1", testBearer, 200*time.Millisecond)
+	t.Cleanup(func() { GrantCheck = prev })
+	ctx, _, tok := tunnelCtx(t, "staff-1")
+	if ok, _ := CheckPAACookie(ctx, tok); ok {
+		t.Fatal("unreachable authority must deny")
+	}
+}
+
+func TestCheckPAACookieRevokedDuringCheckDenies(t *testing.T) {
+	var tun *protocol.Tunnel
+	withGrant(t, func(w http.ResponseWriter, r *http.Request) {
+		tun.Close() // revocation lands while the check is in flight
+		json.NewEncoder(w).Encode(GrantResult{Allow: true})
+	}, time.Second)
+	ctx, tn, tok := tunnelCtx(t, "staff-1")
+	tun = tn
+	if ok, _ := CheckPAACookie(ctx, tok); ok {
+		t.Fatal("a tunnel closed during the check must be denied")
+	}
+}
