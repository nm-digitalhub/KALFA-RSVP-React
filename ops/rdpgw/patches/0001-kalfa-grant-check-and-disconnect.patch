--- a/cmd/rdpgw/protocol/tunnel.go
+++ b/cmd/rdpgw/protocol/tunnel.go
@@ -2,6 +2,7 @@ package protocol
 
 import (
 	"net"
+	"sync"
 	"time"
 
 	"github.com/bolkedebruin/rdpgw/cmd/rdpgw/identity"
@@ -45,6 +46,119 @@ type Tunnel struct {
 
 	// LastSeen is when the server received the last packet from the client
 	LastSeen time.Time
+
+	// mu guards the fields below, which are touched both by the tunnel's own
+	// goroutine and by the admin/revocation path (Close, Info).
+	mu sync.Mutex
+	// subject is the user the PAA cookie was issued to (set before the grant
+	// check so a revocation cannot miss a tunnel whose check is in flight).
+	subject  string
+	clientIp string
+	target   string
+	// closed is set by Close; once set no RDP-server connection may be opened.
+	closed bool
+	// grantTimer fires Close at the grant's hard expiry.
+	grantTimer *time.Timer
+}
+
+// TunnelInfo is a race-free snapshot of a Tunnel for the admin API.
+type TunnelInfo struct {
+	Id          string    `json:"tunnelId"`
+	Subject     string    `json:"user"`
+	ClientIp    string    `json:"clientIp"`
+	Target      string    `json:"target"`
+	ConnectedOn time.Time `json:"connectedOn"`
+}
+
+// SetOwner records who the tunnel belongs to (and where from / to) for the
+// admin API and for revocation by user.
+func (t *Tunnel) SetOwner(subject, clientIp, target string) {
+	t.mu.Lock()
+	t.subject, t.clientIp, t.target = subject, clientIp, target
+	t.mu.Unlock()
+}
+
+// Subject returns the user recorded by SetOwner.
+func (t *Tunnel) Subject() string {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.subject
+}
+
+// IsClosed reports whether Close has been called.
+func (t *Tunnel) IsClosed() bool {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.closed
+}
+
+// SetGrantDeadline makes the tunnel close itself at the given time, whatever
+// the state of the revocation path. A zero time means "no deadline".
+func (t *Tunnel) SetGrantDeadline(at time.Time) {
+	if at.IsZero() {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	if t.grantTimer != nil {
+		t.grantTimer.Stop()
+	}
+	t.grantTimer = time.AfterFunc(time.Until(at), t.Close)
+}
+
+// setRWC stores the connection to the RDP server. It reports false (and the
+// caller must close conn) when the tunnel was already closed, so a revocation
+// that raced with channel creation cannot leave a live backend connection.
+func (t *Tunnel) setRWC(c net.Conn) bool {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return false
+	}
+	t.rwc = c
+	return true
+}
+
+// Close tears the tunnel down from any goroutine. It closes the client
+// transports and the RDP-server connection; the tunnel's Process loop then
+// fails its next read and unwinds through its normal deferred cleanup. Safe to
+// call more than once. It never touches the RDP session on the server: only
+// the gateway tunnel dies.
+func (t *Tunnel) Close() {
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		return
+	}
+	t.closed = true
+	if t.grantTimer != nil {
+		t.grantTimer.Stop()
+	}
+	rwc, in, out := t.rwc, t.transportIn, t.transportOut
+	t.mu.Unlock()
+
+	if rwc != nil {
+		rwc.Close()
+	}
+	if in != nil {
+		in.Close()
+	}
+	if out != nil && out != in {
+		out.Close()
+	}
+}
+
+// Info returns a snapshot for the admin API.
+func (t *Tunnel) Info() TunnelInfo {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return TunnelInfo{
+		Id: t.Id, Subject: t.subject, ClientIp: t.clientIp, Target: t.target,
+		ConnectedOn: t.ConnectedOn,
+	}
 }
 
