# DRAFT - raw table (Plesk firewall-active.sh never touches 'raw'; it flushes only filter-INPUT/FORWARD/OUTPUT, mangle, nat)
*raw
:KALFA_RDP_GUARD6 - [0:0]
-I PREROUTING 1 -p tcp -m tcp --dport 3389 -j KALFA_RDP_GUARD6
-A KALFA_RDP_GUARD6 -i tailscale0 -j RETURN
-A KALFA_RDP_GUARD6 -i lo -j RETURN
-A KALFA_RDP_GUARD6 -j DROP
COMMIT
