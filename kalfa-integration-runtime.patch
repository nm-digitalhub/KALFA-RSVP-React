@@ -0,0 +1,119 @@
+import { describe, expect, it, vi } from 'vitest';
+
+vi.mock('server-only', () => ({}));
+
+import { createCredentialAccessor } from './credential-accessor';
+import { serializeOAuthCredentialSecret } from './credential-secret';
+import type { ProviderDefinition } from './provider';
+
+const provider = {
+  id: 'fixture',
+  displayName: 'Fixture',
+  credentialKind: 'oauth2_authorization_code',
+  presentation: { type: 'bearer' },
+  capabilities: { 'thing.write': ['scope.a'] },
+  apiOrigins: ['https://api.example.test'],
+  oauth: {
+    server: new URL('https://login.example.test/.well-known/openid-configuration'),
+    clientAuth: 'post',
+  },
+  endpoint: () => ({ url: new URL('https://api.example.test/v1/write') }),
+} satisfies ProviderDefinition;
+
+function adminFor(connection: Record<string, unknown> | null, rawSecret: string | null) {
+  const maybeSingle = vi.fn(async () => ({ data: connection, error: null }));
+  const eq = vi.fn(() => ({ maybeSingle }));
+  const select = vi.fn(() => ({ eq }));
+  const from = vi.fn(() => ({ select }));
+  const rpc = vi.fn(async () => ({ data: rawSecret, error: null }));
+
+  return { client: { from, rpc }, rpc };
+}
+
+describe('integration credential accessor', () => {
+  it('returns only the access token from an active matching Vault credential', async () => {
+    const stored = serializeOAuthCredentialSecret({
+      accessToken: 'access-token',
+      refreshToken: 'refresh-token',
+    });
+    const admin = adminFor(
+      {
+        id: 'connection-1',
+        provider: 'fixture',
+        credential_kind: 'oauth2_authorization_code',
+        status: 'active',
+        scopes: ['scope.a'],
+        expires_at: '2030-01-01T00:00:00.000Z',
+      },
+      stored,
+    );
+    const accessor = createCredentialAccessor({
+      admin: admin.client as never,
+      now: () => Date.parse('2029-01-01T00:00:00.000Z'),
+    });
+
+    await expect(
+      accessor.resolve({
+        connectionId: 'connection-1',
+        provider,
+        requiredScopes: ['scope.a'],
+      }),
+    ).resolves.toBe('access-token');
+    expect(admin.rpc).toHaveBeenCalledWith('integrations_read_credential', {
+      p_connection_id: 'connection-1',
+      p_expected_provider: 'fixture',
+      p_expected_kind: 'oauth2_authorization_code',
+    });
+  });
+
+  it('refuses a provider mismatch before reading Vault', async () => {
+    const admin = adminFor(
+      {
+        id: 'connection-1',
+        provider: 'other-provider',
+        credential_kind: 'oauth2_authorization_code',
+        status: 'active',
+        scopes: ['scope.a'],
+        expires_at: null,
+      },
+      null,
+    );
+    const accessor = createCredentialAccessor({ admin: admin.client as never });
+
+    await expect(
+      accessor.resolve({
+        connectionId: 'connection-1',
+        provider,
+        requiredScopes: ['scope.a'],
+      }),
+    ).rejects.toMatchObject({ code: 'integration_connection_provider_mismatch' });
+    expect(admin.rpc).not.toHaveBeenCalled();
+  });
+
+  it('refuses an expired token before reading Vault', async () => {
+    const admin = adminFor(
+      {
+        id: 'connection-1',
+        provider: 'fixture',
+        credential_kind: 'oauth2_authorization_code',
+        status: 'active',
+        scopes: ['scope.a'],
+        expires_at: '2026-09-16T10:00:00.000Z',
+      },
+      null,
+    );
+    const accessor = createCredentialAccessor({
+      admin: admin.client as never,
+      now: () => Date.parse('2026-09-16T10:00:00.000Z'),
+    });
+
+    await expect(
+      accessor.resolve({
+        connectionId: 'connection-1',
+        provider,
+        requiredScopes: ['scope.a'],
+      }),
+    ).rejects.toMatchObject({ code: 'integration_credential_expired' });
+    expect(admin.rpc).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/lib/integrations/credential-accessor.ts b/src/lib/integrations/credential-accessor.ts
