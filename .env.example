# Supabase — public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role key (SERVER ONLY).
# Never expose via NEXT_PUBLIC_*, never commit a real value, never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Management API token (sbp_...) — נדרש רק לאשף ההעברה/התקנה
# (שלב F: עדכון site_url/redirects; שלב G: SQL דרך /v1/projects/{ref}/database/query).
# אופציונלי לריצת האפליקציה עצמה. SERVER ONLY.
SUPABASE_ACCESS_TOKEN=

# SUMIT Payments — https://app.sumit.co.il
NEXT_PUBLIC_SUMIT_COMPANY_ID=      # integer — ציבורי, נדרש ב-BindFormSubmit
NEXT_PUBLIC_SUMIT_API_PUBLIC_KEY=  # string  — ציבורי, נדרש ב-BindFormSubmit
SUMIT_API_KEY=                     # SERVER ONLY — לחיוב מהשרת. לעולם לא ל-NEXT_PUBLIC_
# createAdminClient() זורק אם SUPABASE_SERVICE_ROLE_KEY הוא placeholder; אין בדיקת פורמט —
# כל מפתח שרת תקין מתקבל. מומלץ מפתח חדש sb_secret_... (Settings → API Keys),
# או legacy service_role JWT (Settings → API). SERVER ONLY — לעולם לא NEXT_PUBLIC_, לא ל-Git.

# APP_ORIGIN — SERVER ONLY — לבדיקת CSRF. לא NEXT_PUBLIC_.
APP_ORIGIN=                        # למשל https://beta.kalfa.me

# Calendar integration — src/lib/exchange-ews/. SERVER ONLY.
#
# Microsoft 365 via Graph (the active provider). None of these three is a
# secret; the secret is the private key in the file CERT_PATH points at, which
# is 0600 and gitignored and never leaves the server.
MS_GRAPH_TENANT_ID=                 # מזהה הטננט ב-Entra
MS_GRAPH_CLIENT_ID=                 # Application (client) ID של רישום האפליקציה
MS_GRAPH_CERT_PATH=                 # נתיב מלא ל-PEM שמכיל מפתח פרטי + תעודה יחד
                                    # (ClientCertificateCredential דורש את שניהם באותו קובץ)

# קליטת פניות מדואר Outlook — src/lib/microsoft/. SERVER ONLY.
MS_GRAPH_PRIMARY_MAILBOX=            # התיבה העסקית שממנה נקלטות פניות
MS_GRAPH_INTAKE_FOLDER=KALFA-Intake  # התיקייה הנצפית. לא ה-Inbox בכוונה —
                                     # תיבה אנושית מכילה ניוזלטרים והתראות,
                                     # וכל הודעה שנקלטת הופכת לפנייה ואז לטיוטה.
                                     # התיקייה נוצרת אוטומטית אם אינה קיימת.
MS_GRAPH_WEBHOOK_SECRET=             # סוד. מוחזר ע"י Graph בכל התראה כ-clientState
                                     # ומאומת בנתיב הוובהוק. openssl rand -hex 32

EXCHANGE_PROVIDER=graph             # graph (ברירת מחדל) | off (כיבוי מלא)
                                    # הערך ews הוסר יחד עם המימוש; deployment
                                    # שעדיין נושא אותו ייכשל בעלייה במפורש,
                                    # במקום לעלות בשקט על graph בזמן שמפעיל
                                    # משוכנע שביצע rollback.

#
# EMAIL_PROVIDER בוחר את המוביל בלי deploy — ראה src/lib/email/sender.ts.
#   resend — API טרנזקציוני (הנתיב הפעיל)
#   smtp   — nodemailer מול ההגדרות ב-app_settings (נתיב חזרה לאחור)
EMAIL_PROVIDER=resend
RESEND_API_KEY=                    # סוד. Full access נדרש רק לניהול דומיינים;
                                   # לשליחה בלבד מספיק מפתח מוגבל.
RESEND_WEBHOOK_SECRET=             # סוד. חתימת /api/webhooks/resend. מוצג פעם
                                   # אחת בלבד ביצירת ה-webhook ולא ניתן לקריאה
                                   # חוזרת. בהיעדרו הראוט מחזיר 200 ומתעלם מכל
                                   # אירועי המסירה — בשקט.

# ---------------------------------------------------------------------------
# הושלם 2026-08-23: הקובץ הזה הוא קטלוג המפתחות שאשף ההתקנה משווה מולו
# (src/lib/relocation/install-steps.ts, missingEnvKeys) — כל מפתח שהאפליקציה
# צורכת חייב להופיע כאן בשמו. שמות בלבד; ערכים אמיתיים לעולם לא.
# ---------------------------------------------------------------------------

# Supabase — מפתח publishable (הדור החדש של anon; שניהם קיימים בקוד)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — חיבור DB ישיר לעבודות worker (חובה session pooler, לא db.<ref> —
# ראה זיכרון worker-db-session-pooler; ה-host הוא pooler.supabase.com)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=              # סוד

# Web Push (PWA) — זוג ה-VAPID נוצר בפקודה, לא מוזן ידנית:
#   npx web-push generate-vapid-keys
# אשף ההתקנה מייצר אותם אוטומטית (design §5c); רק ה-SUBJECT מוזן.
# הציבורי נאפה ב-build (NEXT_PUBLIC_) — הייצור חייב לקרות לפני npm run build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                 # סוד
VAPID_SUBJECT=                     # mailto:admin@example.com

# ElevenLabs — סוכני קול
ELEVENLABS_API_KEY=                # סוד
ELEVENLABS_WEBHOOK=                # סוד האימות של ה-post-call webhook

# Meta (WhatsApp Cloud API + Instagram/Ads)
META_APP_ID=
META_APP_SECRET=                   # סוד
META_ADS_ACCESS_TOKEN=             # סוד
META_IG_ACCESS_TOKEN=              # סוד
META_IG_ACCESS_TOKEN_EXPIRES_AT=   # ISO — תזכורת חידוש, לא סוד
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google Analytics 4 — דשבורד /admin/analytics
NEXT_PUBLIC_GA_ID=                 # G-XXXX — ציבורי
GA4_PROPERTY_ID=
GA4_STREAM_ID=
GA4_CHANNEL_GROUP_ID=
GOOGLE_APPLICATION_CREDENTIALS=    # נתיב לקובץ service-account (0600, לא ב-git)

# Exchange/EWS legacy הצפנה + טלמטריית מכשירים + קונסולת נציגים
EXCHANGE_EWS_ENCRYPTION_KEY=       # סוד — openssl rand -hex 32
DEVICE_TELEMETRY_ENABLED=false
KALFA_CONSOLE_SECRET=              # סוד — אימות אפליקציית הקונסולה

# תפעול פנימי
OPS_AGENT_TOKEN=                   # סוד — ה-bearer של sidecar האבחון (:3012)
PGBOSS_DASHBOARD_URL=              # כתובת דשבורד התורים (מכיל את הדומיין —
                                   # האשף משכתב אותו יחד עם APP_ORIGIN)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY= # סוד — יציבות Server Actions בין build-ים
RECONCILE_AUTHORIZED_SET_ENABLED=false # דגל הקפאת נמענים (P0) — הפעלה באישור בעלים
VOX_CI_CREDENTIALS=                # נתיב לקובץ ההרשאות של voxengine-ci (לא ב-git)
