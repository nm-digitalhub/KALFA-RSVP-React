{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/var/www/vhosts/kalfa.me/beta/.claude/fleet/bin/main-inbox.sh",
            "timeout": 20,
            "statusMessage": "בודק תיבת main של ה-fleet..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "postgres-skills": {
      "source": {
        "source": "github",
        "repo": "neondatabase/postgres-skills"
      }
    }
  },
  "enabledPlugins": {
    "postgres-best-practices@postgres-skills": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ]
  }
}