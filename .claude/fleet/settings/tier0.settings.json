{
  "$comment": "Fleet Tier-0 (report-only roles): read + reports + alerts + drafts. dontAsk = fail-closed (anything not allowed is denied, no TTY). deny ALWAYS beats allow. Loaded via `claude -p --settings <this file> --setting-sources project` so the owner's interactive allowlist (settings.local.json) and user-level settings NEVER apply to fleet runs. File-path rules use Edit(path)/Read(path) forms ONLY — Write(path)/NotebookEdit(path)/Glob(path) rules are accepted but never matched by the permission checks (verified against July 2026 docs), so an Edit(path) allow is what grants the Write tool too. The PreToolUse guard hook is a third, hook-layer wall (exit 2 blocks before permission evaluation; allow rules cannot override it).",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Agent",
      "Edit(//var/www/vhosts/kalfa.me/beta/.fleet-logs/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(pm2 ls)",
      "Bash(pm2 jlist)",
      "Bash(pm2 status:*)",
      "Bash(pm2 logs:*)",
      "Bash(pm2 describe:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(node dist/fleet-agent-cli.cjs:*)",
      "Bash(node --env-file=.env.local dist/fleet-agent-cli.cjs:*)",
      "Bash(npm run fleet:agent:*)",
      "Bash(df:*)",
      "Bash(free:*)",
      "Bash(uptime)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(du:*)",
      "Bash(ps:*)",
      "Bash(which:*)",
      "Bash(pm2 list)",
      "Bash(pm2 show:*)",
      "Workflow"
    ],
    "deny": [
      "Read(//var/www/vhosts/kalfa.me/beta/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta/**/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta-fleet/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta-fleet/**/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta/.claude/fleet/.token.env)",
      "Read(//var/www/vhosts/kalfa.me/beta/vox_ci_credentials.json)",
      "Read(//var/www/vhosts/kalfa.me/beta/.secrets/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/src/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/supabase/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/scripts/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/worker/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/.claude/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/agent_configs/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/package.json)",
      "Edit(//var/www/vhosts/kalfa.me/beta/.env*)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git worktree:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx:*)",
      "Bash(pm2 restart:*)",
      "Bash(pm2 stop:*)",
      "Bash(pm2 start:*)",
      "Bash(pm2 delete:*)",
      "Bash(pm2 kill:*)",
      "Bash(pm2 save:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(crontab:*)",
      "Bash(env:*)",
      "Bash(printenv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/var/www/vhosts/kalfa.me/beta/.claude/fleet/settings/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "small"
}
