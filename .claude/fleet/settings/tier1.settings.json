{
  "$comment": "Fleet Tier-1 (qa-runner, dev-engineer): Tier-0 plus code edits (confined to the beta-fleet worktree), verification gates, fleet/* branch pushes, PR creation, and beta deploy. Every prod-DB / secrets / infra deny from Tier-0 stays. File-path rules use Edit(path)/Read(path) forms only — Edit(path) is what grants/denies the Write tool too (Write(path) rules are never matched; verified against July 2026 docs). Deny beats allow, so the .claude/fleet + agent_configs denies carve those out of the worktree allow.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(//var/www/vhosts/kalfa.me/beta-fleet/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/.fleet-logs/**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git branch:*)",
      "Bash(git push origin fleet/:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run deploy)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(pm2 ls)",
      "Bash(pm2 jlist)",
      "Bash(pm2 status:*)",
      "Bash(pm2 logs:*)",
      "Bash(pm2 describe:*)",
      "Bash(pm2 restart kalfa-beta)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(node dist/fleet-agent-cli.cjs:*)",
      "Bash(node --env-file=.env.local dist/fleet-agent-cli.cjs:*)",
      "Bash(npm run fleet:agent:*)",
      "Bash(df:*)",
      "Bash(free:*)",
      "Bash(uptime)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Read(//var/www/vhosts/kalfa.me/beta/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta/**/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta-fleet/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta-fleet/**/.env*)",
      "Read(//var/www/vhosts/kalfa.me/beta/.claude/fleet/.token.env)",
      "Read(//var/www/vhosts/kalfa.me/beta/vox_ci_credentials.json)",
      "Edit(//var/www/vhosts/kalfa.me/beta/src/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/supabase/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/scripts/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/worker/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/.claude/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/agent_configs/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta/package.json)",
      "Edit(//var/www/vhosts/kalfa.me/beta-fleet/.claude/fleet/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta-fleet/agent_configs/**)",
      "Edit(//var/www/vhosts/kalfa.me/beta-fleet/.env*)",
      "Edit(//var/www/vhosts/kalfa.me/beta-fleet/**/.env*)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git worktree:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(supabase:*)",
      "Bash(psql:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(pm2 stop:*)",
      "Bash(pm2 start:*)",
      "Bash(pm2 delete:*)",
      "Bash(pm2 kill:*)",
      "Bash(pm2 save:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(crontab:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/var/www/vhosts/kalfa.me/beta/.claude/fleet/settings/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
