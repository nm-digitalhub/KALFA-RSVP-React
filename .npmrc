# Keep devDependencies on disk even when NODE_ENV=production (npm's `omit` defaults to 'dev' then, so any
# `npm install` would delete vitest/eslint/tsc/@tailwindcss/postcss, which `npm run build` and the tests need).
# npm docs, config `omit`: "If a package type appears in both the --include and --omit lists, then it will be included."
include=dev
