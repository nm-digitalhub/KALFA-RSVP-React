# Keep devDependencies on disk even when NODE_ENV=production (npm's `omit` defaults to 'dev' then, so any
# `npm install` would delete vitest/eslint/tsc/@tailwindcss/postcss, which `npm run build` and the tests need).
# npm docs, config `omit`: "If a package type appears in both the --include and --omit lists, then it will be included."
include=dev

# npm 12 defaults `allow-remote` to `none`. `npm install --package-lock-only` and `--dry-run` open a package that has
# bundled dependencies (@tailwindcss/oxide-wasm32-wasi) by its full tarball URL, which `none` refuses (EALLOWREMOTE),
# even though the URL is on our own registry. `root` does not cover that call; only `all` does.
# npm docs, config `allow-remote`: "Opt in explicitly per project (in `.npmrc`) or per command (on the CLI)."
allow-remote=all
