            "callback_when_text": {
                "type": "string",
                "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05d7\u05d6\u05e8\u05d4 \u05e9\u05d4\u05e4\u05d5\u05e0\u05d4 \u05e6\u05d9\u05d9\u05df \u05d1\u05de\u05d9\u05dc\u05d5\u05ea\u05d9\u05d5, \u05e2\u05d3 200 \u05ea\u05d5\u05d5\u05d9\u05dd. \u05dc\u05d3\u05d5\u05d2\u05de\u05d4: \"\u05de\u05d7\u05e8 \u05d1\u05e9\u05de\u05d5\u05e0\u05d4 \u05d1\u05e2\u05e8\u05d1\". \u05d0\u05d9\u05df \u05dc\u05d4\u05de\u05e6\u05d9\u05d0 \u05de\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d0 \u05d4\u05ea\u05d1\u05e7\u05e9.",
                "is_system_provided": false,
                "dynamic_variable": "",
                "allowed_values_dynamic_variable": "",
