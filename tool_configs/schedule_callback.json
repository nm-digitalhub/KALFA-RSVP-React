            },
            "callback_iso": {
                "type": "string",
                "description": "\u05de\u05d5\u05e2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d1\u05e2\u05ea\u05d9\u05d3 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 ISO 8601, \u05e2\u05d3 40 \u05ea\u05d5\u05d5\u05d9\u05dd. \u05d7\u05d9\u05e9\u05d5\u05d1 \u05d6\u05de\u05df \u05d9\u05d7\u05e1\u05d9 \u05de\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc {{system__time_utc}}; \u05de\u05d5\u05e2\u05d3 \u05e9\u05e0\u05d0\u05de\u05e8 \u05d1\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05e4\u05d5\u05e8\u05e9 \u05dc\u05e4\u05d9 Asia/Jerusalem \u05d1\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05d1\u05d5\u05e7\u05e9, \u05db\u05d5\u05dc\u05dc \u05e9\u05e2\u05d5\u05df \u05e7\u05d9\u05e5 \u05d0\u05d5 \u05d7\u05d5\u05e8\u05e3. \u05d0\u05d9\u05df \u05dc\u05d4\u05e0\u05d9\u05d7 \u05d4\u05e4\u05e8\u05e9 UTC \u05e7\u05d1\u05d5\u05e2 \u05dc\u05e4\u05d9 \u05d7\u05d5\u05d3\u05e9. \u05dc\u05d3\u05d5\u05d2\u05de\u05ea \u05e4\u05d5\u05e8\u05de\u05d8 \u05d1\u05dc\u05d1\u05d3: 2026-10-13T17:00:00Z. \u05d0\u05dd \u05d4\u05de\u05d5\u05e2\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05d1\u05e8\u05d5\u05e8, \u05d9\u05e9 \u05dc\u05e9\u05d0\u05d5\u05dc \u05d4\u05d1\u05d4\u05e8\u05d4. \u05d0\u05d9\u05df \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05e8\u05d9\u05e7 \u05d5\u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05ea\u05d6\u05de\u05d5\u05df.",
